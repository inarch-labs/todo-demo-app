ANTHROPIC_API_KEY=                   # from console.anthropic.com — powers natural-language task parsing

INARCH_ADMIN_SECRET=                 # pick any string — password for the researcher panel at /inarch-panel
INARCH_TELEMETRY_DATABASE_URL=       # Postgres connection string, e.g. postgresql://user:pass@localhost:5432/inarch_dev

# Turso (production) — leave blank for local dev, which uses file:.data/todo.db
TURSO_DATABASE_URL=                  # libsql://your-db.turso.io
TURSO_AUTH_TOKEN=                    # from: turso db tokens create <db-name>
